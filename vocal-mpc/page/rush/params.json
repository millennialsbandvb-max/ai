    {"key": "v1_level", "name": "V1 Level", "min": 0, "max": 100, "default": 80, "unit": "%"},
    {"key": "v1_pan", "name": "V1 Pan", "min": -100, "max": 100, "default": -40},
    {"key": "v2", "name": "Voice 2", "options": ["Off", "Oct Down", "6th Down", "5th Down", "4th Down", "3rd Down", "Unison", "3rd Up", "4th Up", "5th Up", "6th Up", "Oct Up", "Oct+3rd", "Oct+5th"], "default": 9},
    {"key": "v2_level", "name": "V2 Level", "min": 0, "max": 100, "default": 0, "unit": "%"},
    {"key": "v2_pan", "name": "V2 Pan", "min": -100, "max": 100, "default": 40},
    {"key": "dry", "name": "Dry", "min": 0, "max": 100, "default": 100, "unit": "%"},
